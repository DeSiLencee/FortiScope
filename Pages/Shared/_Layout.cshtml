<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="FortiScope FortiGate ağ izleme paneli" />
    <title>@ViewData["Title"] | FortiScope</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header"><div class="header-inner">
        <a class="brand" asp-page="/Index" aria-label="FortiScope ana sayfa"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>Forti<span>Scope</span></span></a>
        <span class="header-context">Ağ İzleme</span>
    </div></header>
    <main>@RenderBody()</main>
    <footer class="site-footer"><span>FortiScope</span> · Yerel ağ izleme paneli</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
