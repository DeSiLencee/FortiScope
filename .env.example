# Host port used to open the FortiScope dashboard.
FORTISCOPE_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Keep false for direct HTTP on port 8080. Let a reverse proxy terminate HTTPS.
HttpsRedirectionEnabled=false

# Shared SNMPv3 security configuration. Device IP and username are managed in the dashboard.
Snmp__Port=161
Snmp__Version=v3
Snmp__SecurityLevel=authPriv
Snmp__AuthenticationProtocol=SHA1
Snmp__PrivacyProtocol=AES128
Snmp__TimeoutMilliseconds=3000

# Required for SNMP polling. Replace these placeholders in your local .env file.
Snmp__AuthPassword=CHANGE_ME
Snmp__PrivacyPassword=CHANGE_ME
